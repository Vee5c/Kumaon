{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kumaon-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "kumaon-astro",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "kumaon-phone",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "preview",
        "--host",
        "--port",
        "4400"
      ],
      "port": 4400
    }
  ]
}