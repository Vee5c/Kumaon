<script>
  const root = document.querySelector('.work');
  if(root){
    const track = root.querySelector('.work-track');
    const items = [...track.children];
    const speeds = items.map((el) => parseFloat(el.dataset.s || '1'));
    const fastest = Math.max(...speeds);
    const videos = [...root.querySelectorAll('.card-video')];
    /* phones and slow or data-saving connections get the light version of each film (about a quarter of the size) */
    const conn = navigator.connection;
    /* the stacked phone layout: narrow AND tall; a phone turned on its side is short, so it uses the wide layout */
    const phoneMQ = matchMedia('(max-width:820px) and (min-height:521px)');
    const isPhone = () => phoneMQ.matches;
    const lite = innerWidth <= 820 || (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '')));
    videos.forEach((v) => { v.src = lite ? v.dataset.srcSm : v.dataset.src; });
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bgLayers = [...root.querySelectorAll('.bg-layer')];
    const vh = () => (window.__vh ? window.__vh() : innerHeight);   /* the steady page height set in the head */
    let lastW = innerWidth;
    let dist = 0, hold = 0;
    const clamp = (v) => Math.min(Math.max(v, 0), 1);

    /* The section is as tall as the sideways distance plus one screen; scrolling down slides the row left, and when
       it reaches the end the page carries on down. Each item moves at its own speed (the later, the faster), so the
       gaps between neighbours slowly close. The fastest item (the last) lands exactly at the end. */
    /* on tablets and phones the temple stands in the empty space under the Metal film and travels with it; on desktop it stays in the background layer */
    const templeLayer = root.querySelector('.bg-temple');
    const templeSvg = templeLayer && templeLayer.querySelector('svg');
    const lyfe = track.querySelector(':scope > .card.is-wide');   /* the Metal film: the first wide card in the row */
    let templeHolder = null;
    const templeExtras = templeLayer ? [...templeLayer.querySelectorAll('.t-petals, .t-fireflies')] : [];   /* the day's petals and the night's fireflies go where the temple goes */
    /* the stone of each shrine is given a long plain extension below its base (same colours), so on a phone it can run down to the bottom of the screen
       however far the toolbars have slid, instead of ending in a flat edge */
    let stoneExtended = false;
    function extendStone(){
      if(stoneExtended || !templeSvg) return;
      const NS = 'http://www.w3.org/2000/svg';
      templeSvg.querySelectorAll('.t-back, .t-mid, .t-front').forEach((g) => {
        [...g.querySelectorAll(':scope > path')].forEach((p) => {
          if(p.classList.contains('tk') || p.classList.contains('td')) return;
          const b = p.getBBox(); if(!b.width) return;
          const e = document.createElementNS(NS, 'path');
          e.setAttribute('class', p.getAttribute('class') || '');
          e.setAttribute('d', `M${b.x} ${b.y + b.height - 40}H${b.x + b.width}V${b.y + b.height + 1600}H${b.x}Z`);
          g.insertBefore(e, g.firstChild);
        });
      });
      stoneExtended = true;
    }
    function placeTemple(){
      if(!templeSvg) return;
      const small = isPhone() && lyfe;
      if(small){
        if(!templeHolder){ templeHolder = document.createElement('div'); templeHolder.className = 'bg-temple card-temple'; templeHolder.setAttribute('aria-hidden', 'true'); lyfe.appendChild(templeHolder); }
        if(templeSvg.parentNode !== templeHolder){ templeHolder.appendChild(templeSvg); templeExtras.forEach((e) => templeHolder.appendChild(e)); }
        extendStone();
        /* stand it on the floor of the screen that is really visible: the pinned scene reaches under a phone's toolbar, so the foot meets the scene's bottom padding
           (the part kept clear of the toolbar and the home indicator) and the stone below it runs on to the very bottom, whatever the toolbar is doing */
        const pin = root.querySelector('.work-pin');
        if(pin){
          const clear = parseFloat(getComputedStyle(pin).paddingBottom) || 0;
          templeHolder.style.marginTop = '0px';
          const gap = pin.getBoundingClientRect().bottom - clear - lyfe.getBoundingClientRect().bottom - templeHolder.offsetHeight;
          templeHolder.style.marginTop = Math.max(0, gap) + 'px';
        }
      } else if(templeSvg.parentNode !== templeLayer){ templeLayer.appendChild(templeSvg); templeExtras.forEach((e) => templeLayer.appendChild(e)); }
    }
    function layout(){
      placeTemple();
      if(still) return;
      const last = track.lastElementChild;
      const end = last.offsetLeft + last.offsetWidth + parseFloat(getComputedStyle(track).paddingRight);
      dist = Math.max(0, end - innerWidth);
      /* on phones the first screen holds still for a short stretch of scrolling before the row starts to slide */
      hold = isPhone() ? vh() * 0.55 : 0;
      root.style.height = (vh() + dist + hold) + 'px';
      bgLayers.forEach((l) => { l.style.width = (innerWidth + dist * parseFloat(l.dataset.bgs)) + 'px'; });
      update();
    }
    const medias = [...root.querySelectorAll('.work-track > .card, .work-tail .card, .work-lead .card')].map((c) => c.querySelector('.card-media'));
    const floaters = [...track.querySelectorAll(':scope > .card')];
    function update(){
      if(still) return;
      const box = root.getBoundingClientRect();
      if(box.bottom < -40 || box.top > vh() + 40) return;   /* off screen: nothing to move */
      const travel = root.offsetHeight - vh();
      const raw = travel > 0 ? Math.max(-box.top - hold, 0) / Math.max(travel - hold, 1) : 0;
      const q = clamp(raw);
      const p = hold ? 0.75 * q + 0.25 * q * q * (3 - 2 * q) : q;   /* a soft start after the hold */
      /* read every frame position first, then write, so the browser lays the page out once per frame, not once per film */
      const shifts = medias.map((m) => { const r = m.getBoundingClientRect(); return ((r.left + r.width / 2) - innerWidth / 2) / innerWidth; });
      const d = dist / fastest;
      bgLayers.forEach((l) => { l.style.transform = `translate3d(${-p * dist * parseFloat(l.dataset.bgs)}px,0,0)`; });
      const u = Math.min(vh() * 0.01, innerWidth * (isPhone() ? 0.018 : 0.0085));
      items.forEach((el, i) => {
        const y = floaters.includes(el) ? (floaters.indexOf(el) % 2 ? -1 : 1) * Math.sin(p * Math.PI) * 4 * u : 0;
        el.style.transform = `translate3d(${-p * d * speeds[i]}px,${y}px,0)`;
      });
      /* the picture inside each frame drifts the opposite way to the row, so every film feels deeper than its frame */
      medias.forEach((m, i) => m.style.setProperty('--vx', `${Math.max(-7.5, Math.min(7.5, -shifts[i] * 16)).toFixed(2)}%`));
    }
    let queued = false;
    addEventListener('scroll', () => { if(!queued){ queued = true; requestAnimationFrame(() => { queued = false; update(); }); } }, { passive:true });
    addEventListener('resize', () => { if(innerWidth !== lastW){ lastW = innerWidth; layout(); } });
    addEventListener('load', layout);
    addEventListener('vhchange', layout);
    layout();

    /* Films preview themselves: while a frame is on screen it plays its first few seconds, muted, on a loop. Pressing a film plays it
       from the start with sound and controls (one at a time); when it ends or leaves the screen it drops back to the preview. */
    const PREVIEW = 6;                                  /* seconds of each film that loop as its preview */
    const lengthOf = (v) => parseFloat(v.dataset.preview || PREVIEW);   /* a film can have a shorter preview (the animated intro loops its first 2 seconds) */
    const startOf = (v) => parseFloat(v.dataset.at || '0');   /* where that preview starts: the poster's own moment */
    const canPreview = !still && !(navigator.connection && navigator.connection.saveData);
    let full = null;
    const toPreview = (v) => {
      const m = v.closest('.card-media');
      v.controls = false; v.muted = true; m.classList.remove('is-playing');
      if(full === v) full = null;
      v.currentTime = startOf(v);
    };
    videos.forEach((v) => {
      v.muted = true;
      v.addEventListener('loadedmetadata', () => { if(v !== full) v.currentTime = startOf(v); });
      v.addEventListener('timeupdate', () => { if(v !== full && v.currentTime >= startOf(v) + lengthOf(v)) v.currentTime = startOf(v); });
      v.addEventListener('ended', () => { if(v === full){ toPreview(v); if(canPreview) v.play().catch(() => {}); } });
    });
    root.addEventListener('click', (e) => {
      const m = e.target.closest('.card-media');
      if(!m || m.classList.contains('is-playing')) return;
      const v = m.querySelector('video');
      if(full && full !== v){ const f = full; toPreview(f); if(!canPreview) f.pause(); }
      full = v; v.loop = false; v.muted = false; v.currentTime = 0; v.controls = true; m.classList.add('is-playing');
      v.play().catch(() => {});
    });
    root.addEventListener('keydown', (e) => { if((e.key === 'Enter' || e.key === ' ') && e.target.classList.contains('card-media')){ e.preventDefault(); e.target.click(); } });
    const io = new IntersectionObserver((es) => es.forEach((en) => {
      const v = en.target;
      if(en.isIntersecting){
        if(canPreview && v !== full){ v.loop = true; v.preload = 'auto'; v.play().catch(() => {}); }
      } else {
        v.pause();
        if(v === full) toPreview(v);
      }
    }), { threshold:0.25 });
    videos.forEach((v) => io.observe(v));
  }

</script>
