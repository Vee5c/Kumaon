---
import { media } from '../data/media.js';
import WorkCard from './WorkCard.astro';
import { cards, crateCovers } from '../data/cards.js';
const [lead, ...others] = cards;
const tail = others[others.length - 1];
const rest = others.slice(0, -1);
const count = String(cards.length).padStart(2, '0');
---
<section id="work" class="work" aria-label="Selected work">
  <!-- the top edge: a long, smooth contour line like the ones drifting behind the row, rising into the orange scene above as the section slides up over it -->
  <div class="work-crest" aria-hidden="true">
    <!-- birds on the orange side of the edge, so the sky is alive above the line as well as below it -->
    <div class="crest-birds">
      <span class="bird on-line" style="--size:40px; --dur:34s; --delay:-12s"><svg viewBox="0 0 24 12" aria-hidden="true"><path d="M0 7C5 -1 10 1 12 6C14 1 19 -1 24 7C19 4 14 6 12 11C10 6 5 4 0 7Z"/></svg></span>
      <span class="bird" style="--top:calc(18% + 3px); --size:28px; --dur:46s; --delay:-30s"><svg viewBox="0 0 24 12" aria-hidden="true"><path d="M0 7C5 -1 10 1 12 6C14 1 19 -1 24 7C19 4 14 6 12 11C10 6 5 4 0 7Z"/></svg></span>
    </div>
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false">
      <path class="wave-fill" d="M0 46C180 28 360 22 540 34S900 62 1100 50S1340 30 1440 38V80H0Z"/>
      <path class="wave-line" d="M0 46C180 28 360 22 540 34S900 62 1100 50S1340 30 1440 38"/>
    </svg>
  </div>
