<script>
  const box = document.querySelector('.ridge-snow');
  const cv = box && box.querySelector('canvas');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const T0 = performance.now();
  const START = 1500, SPAN = 9500, CURVE = 1.3;   /* the patches start at 1.5 s and are all in by 11 s; dots arrive a little slower at first and a little faster towards the end */
  if(box){ const v = new URLSearchParams(location.search).get('snow'); box.dataset.snow = ['a','b','c','d'].includes(v) ? v : 'd'; }

  /* The mountain's snow, drawn on the graphics card. The light-blue patches (the SVG outlines above) become a mask; a small shader fills it with round dots that
     arrive one by one until they close up into the full patch. If
     WebGL is not there, the same arrival is done with SVG masks (below); with reduced motion the patches are simply there. */
  const patches = box ? [...box.querySelectorAll('.patch')] : [];
  let glOK = false;
  if(box && !calm && box.dataset.snow === 'd' && patches.length){
    try{
      const gc = document.createElement('canvas'); gc.className = 'ridge-gl';
      const gl = gc.getContext('webgl', { premultipliedAlpha: true, antialias: false, alpha: true });
      if(!gl) throw new Error('no webgl');
      const sh = (type, src) => { const o = gl.createShader(type); gl.shaderSource(o, src); gl.compileShader(o); if(!gl.getShaderParameter(o, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(o)); return o; };
      const prog = gl.createProgram();
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, 'attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }'));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, `
        #ifdef GL_FRAGMENT_PRECISION_HIGH
        precision highp float;
        #else
        precision mediump float;
        #endif
        uniform vec2 uRes; uniform float uP; uniform sampler2D uMask;
        float h21(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
        void main(){
          vec2 uv = gl_FragCoord.xy / uRes;
          float m = texture2D(uMask, vec2(uv.x, 1.0 - uv.y)).a;
          if(m < 0.004){ gl_FragColor = vec4(0.0); return; }
          vec2 g = uv * vec2(1440.0, 220.0) / 2.4;
          vec2 id0 = floor(g), f0 = g - id0;
          float cover = 0.0;
          for(int j = -1; j <= 1; j++){ for(int i = -1; i <= 1; i++){
            vec2 id = id0 + vec2(float(i), float(j));
            vec2 c = vec2(float(i), float(j)) + 0.5 + (vec2(h21(id), h21(id + 7.1)) - 0.5) * 0.5;
            float d = length(f0 - c);
            float rad = 0.95 * (0.92 + 0.16 * h21(id + 1.7));
            float appear = smoothstep(h21(id + 3.3), h21(id + 3.3) + 0.12, uP);
            float dot_ = appear * (1.0 - smoothstep(rad - 0.22, rad, d));
            cover = max(cover, dot_);
            
          } }
          cover = max(cover, smoothstep(0.985, 1.0, uP));
          vec3 col = vec3(0.812, 0.890, 0.925);
                    float a = cover * m;
          gl_FragColor = vec4(col * a, a);
        }`));
      gl.linkProgram(prog);
      if(!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error('link');
      gl.useProgram(prog);
      const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'a'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const U = (n) => gl.getUniformLocation(prog, n);
      const uRes = U('uRes'), uP = U('uP');

      /* the mask: the ridge outline, with every patch filled inside it, drawn once at twice the 1440 x 220 drawing */
      /* both the patches and the ridge are drawn a hair too big (0.4 units each way), so the snow also covers the thin fringe where the orange meets the sky */
      const mc = document.createElement('canvas'); mc.width = 2880; mc.height = 440;
      const mx = mc.getContext('2d'); mx.scale(2, 2);
      mx.fillStyle = mx.strokeStyle = '#fff'; mx.lineWidth = 0.8; mx.lineJoin = 'round';
      patches.forEach((pt) => { const q = new Path2D(pt.getAttribute('d')); mx.fill(q); mx.stroke(q); });
      const ridge = box.querySelector('#rs-ridge path');
      if(ridge){
        const rc = document.createElement('canvas'); rc.width = 2880; rc.height = 440;
        const rx = rc.getContext('2d'); rx.scale(2, 2); rx.fillStyle = rx.strokeStyle = '#fff'; rx.lineWidth = 0.8; rx.lineJoin = 'round';
        const rq = new Path2D(ridge.getAttribute('d')); rx.fill(rq); rx.stroke(rq);
        mx.setTransform(1, 0, 0, 1, 0, 0); mx.globalCompositeOperation = 'destination-in'; mx.drawImage(rc, 0, 0);
      }
      const tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, mc);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.uniform1i(U('uMask'), 0);
      gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

      const caps = box.querySelector('.ridge-caps'); caps.after(gc);
      const fit = () => {
        const d = Math.min(devicePixelRatio || 1, 1.5), w = Math.round(gc.clientWidth * d), h = Math.round(gc.clientHeight * d);
        if(w && (gc.width !== w || gc.height !== h)){ gc.width = w; gc.height = h; gl.viewport(0, 0, w, h); }
      };
      let live = false, last = 0;
      const frame = (now) => {
        if(!live) return;
        requestAnimationFrame(frame);
        if(now - last < 33) return;   /* about 30 frames a second is plenty for snow */
        last = now;
        fit();
        const u = Math.min(1, Math.max(0, (now - T0 - START) / SPAN));
        gl.uniform2f(uRes, gc.width, gc.height);
        gl.uniform1f(uP, Math.pow(u, CURVE) * 1.12);
        gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };
      new IntersectionObserver((es) => { const v = es[0].isIntersecting && !document.hidden; if(v && !live){ live = true; requestAnimationFrame(frame); } else if(!v) live = false; }).observe(box);
      document.addEventListener('visibilitychange', () => { if(document.hidden) live = false; else if(!live && box.getBoundingClientRect().bottom > 0){ live = true; requestAnimationFrame(frame); } });
      fit();
      patches[0].parentNode.style.display = 'none';   /* the SVG patches give way to the shader */
      glOK = true;
    }catch(err){ glOK = false; const gcv = box.querySelector('.ridge-gl'); if(gcv) gcv.remove(); }
  }

  /* fallback: small round snow dots fade in at random inside each patch, never changing size, until they have closed up into the full patch */
  if(box && !glOK && box.dataset.snow === 'd' && !calm){
    const NS = 'http://www.w3.org/2000/svg';
    const defs = box.querySelector('defs');
    const boxes = patches.map((im) => im.getBBox());
    patches.forEach((im, i) => {
      const {x, y, width: w, height: h} = boxes[i];
      const m = document.createElementNS(NS, 'mask');
      m.setAttribute('id', 'rs-dots-' + i); m.setAttribute('maskUnits', 'userSpaceOnUse');
      m.setAttribute('x', x - 4); m.setAttribute('y', y - 4); m.setAttribute('width', w + 8); m.setAttribute('height', h + 8);
      const g = 2.4, R = g * 0.95;
      for(let cy = y + g / 2; cy < y + h + g / 2; cy += g){
        for(let cx = x + g / 2; cx < x + w + g / 2; cx += g){
          const c = document.createElementNS(NS, 'circle');
          const px = cx + (Math.random() - 0.5) * g * 0.5, py = cy + (Math.random() - 0.5) * g * 0.5;
          c.setAttribute('cx', px.toFixed(1)); c.setAttribute('cy', py.toFixed(1)); c.setAttribute('r', (R * (0.92 + Math.random() * 0.16)).toFixed(1)); c.setAttribute('fill', '#fff');
          c.style.opacity = '0';
          const delay = START + Math.pow(Math.random(), 1 / CURVE) * SPAN;
          c.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 1000 + Math.random() * 1500, delay, easing: 'ease-in-out', fill: 'forwards' });
          m.appendChild(c);
        }
      }
      defs.appendChild(m);
      im.setAttribute('mask', 'url(#rs-dots-' + i + ')');
    });
  }

  /* the flakes: they fall from the sky above the peaks, settle on the mountain's edge and melt into it, and are blown aside where the pointer gusts through them.
     The snowfall sound (sound.js) makes them fall a touch faster (window.kcSnowBoost is 1 while it plays). */
  if(cv && !calm){
    const prof = JSON.parse(cv.dataset.profile);
    const ctx = cv.getContext('2d');
    /* ridge top (in the 1440 x 220 drawing) at a given x */
    const topAt = (vx) => {
      for(let i = 1; i < prof.length; i++){
        if(vx <= prof[i][0]){ const a = prof[i - 1], b = prof[i], k = (vx - a[0]) / Math.max(1, b[0] - a[0]); return a[1] + (b[1] - a[1]) * k; }
      }
      return prof[prof.length - 1][1];
    };
    let w = 0, h = 0, dpr = 1, flakes = [], running = false, last = 0, speed = 1;
    const wind = { x: 0, y: 0, vx: 0, vy: 0, on: false };   /* the pointer over the flakes, in their canvas's pixels, and how fast it moves */
    const spawn = (f, anywhere) => {
      f.x = w * (0.74 + Math.random() * 0.36);   /* a little beyond the right edge: the slant carries those in, so the right side keeps as much snow as the left */ f.y = anywhere ? Math.random() * h : -6;
      f.r = 0.9 + Math.random() * 1.9; f.v = 17 + Math.random() * 26; f.s = Math.random() * 6.28; f.a = 0.45 + Math.random() * 0.45;
      f.dx = 0; f.rest = 0; f.life = 0;
    };
    const size = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = cv.clientWidth; h = cv.clientHeight;
      cv.width = w * dpr; cv.height = h * dpr;
      flakes = Array.from({ length: Math.max(20, Math.round(w / 19)) }, () => { const f = {}; spawn(f, true); return f; });
    };
    const tick = (t) => {
      if(!running) return;
      const dt = Math.min((t - last) / 1000, 0.05); last = t;
      const ridgeH = box.clientHeight;
      wind.vx *= Math.pow(0.02, dt); wind.vy *= Math.pow(0.02, dt);   /* a gust dies away on its own, and with no movement there is none */
      const windSpeed = Math.hypot(wind.vx, wind.vy);
      speed += ((1 + 0.12 * (window.kcSnowBoost ? 1 : 0)) - speed) * Math.min(1, dt * 1.2);   /* a slow, small change: the sound never makes the snow rush */
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#9fc3d6';
      for(const f of flakes){
        const ground = h - ridgeH + (topAt(f.x / w * 1440) / 220) * ridgeH;   /* the ridge's edge under this flake */
        if(wind.on && windSpeed > 80){   /* only while the pointer is actually moving: held still, it does nothing */
          const ddx = f.x - wind.x, ddy = f.y - wind.y, d2 = ddx * ddx + ddy * ddy;
          if(d2 < 110 * 110){
            const k = 1 - Math.sqrt(d2) / 110;
            f.dx += wind.vx * k * 0.005; f.y -= Math.min(6, Math.abs(wind.vx) * k * 0.01);
            if(f.rest){ f.rest = 0; f.life = 0; f.y = ground - f.r - 1; }   /* a settled flake is lifted off again */
          }
        }
        if(f.rest){
          f.life += dt;
          const k = f.life / f.rest; if(k >= 1){ spawn(f, false); continue; }
          ctx.globalAlpha = f.a * (1 - k) * 0.85;
          ctx.beginPath(); ctx.arc(f.x, ground - f.r * 0.4, f.r * (1 - k * 0.5), 0, 6.2832); ctx.fill();
          continue;
        }
        f.y += f.v * speed * dt; f.s += dt * 0.7; f.x += (Math.sin(f.s) * 7 * speed - f.v * 0.21 * speed + f.dx) * dt;   /* the fall slants from right to left, about 12 degrees */ f.dx *= Math.pow(0.35, dt);
        if(f.y >= ground - f.r){ f.rest = 1.2 + Math.random() * 2; f.life = 0; f.y = ground - f.r; continue; }   /* it lands, stays a moment, and melts into the snow */
        const kx = f.x / w, thin = Math.min(1, Math.max(0, (kx - 0.5) / 0.24));   /* over the text on the left the snow thins out and is gone */
        if(kx < 0.5){ spawn(f, false); continue; }
        const fadeIn = Math.min(1, (f.y + 6) / 40);
        ctx.globalAlpha = f.a * fadeIn * thin;
        ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, 6.2832); ctx.fill();
      }
      requestAnimationFrame(tick);
    };
    new IntersectionObserver((es) => { running = es[0].isIntersecting; if(running){ last = performance.now(); requestAnimationFrame(tick); } }).observe(box);
    let sizedW = innerWidth;
    addEventListener('resize', () => { if(innerWidth !== sizedW){ sizedW = innerWidth; size(); } });   /* not for a phone's toolbars sliding (the height alone changes) */
    size();

    /* the pointer gusting through: its speed over the flakes blows them aside */
    let px = 0, py = 0, pt = 0;
    document.addEventListener('pointermove', (e) => {
      if(e.pointerType === 'touch') return;
      const r = cv.getBoundingClientRect(), now = performance.now(), dtm = Math.max(8, now - pt);
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if(inside){
        wind.vx = Math.max(-900, Math.min(900, (e.clientX - px) / dtm * 1000)); wind.vy = (e.clientY - py) / dtm * 1000;
        wind.x = e.clientX - r.left; wind.y = e.clientY - r.top; wind.on = true;
      } else wind.on = false;
      px = e.clientX; py = e.clientY; pt = now;
    }, { passive: true });
  }
</script>
