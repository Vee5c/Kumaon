<script>
  /* a gust over the water, very subtle: a quick pointer pass over the Contact section sends a few faint glints of light along the surface in the direction it moves, bends
     the ripple lines for a moment, and nudges the diyas and the boat sideways a few pixels, then they settle back. Like the snow's flakes, it dies away the moment the pointer stops. */
  const water = document.querySelector('.contact .water');
  if(water && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer: fine)').matches){
    const sec = water.closest('.contact');
    const cv = document.createElement('canvas'); cv.className = 'water-shimmer'; water.appendChild(cv);
    /* ripple bend: while the gust blows, the ripple lines are displaced by a slow noise, so they wave for a moment and flatten again */
    const NSS = 'http://www.w3.org/2000/svg';
    const fsvg = document.createElementNS(NSS, 'svg'); fsvg.setAttribute('width', '0'); fsvg.setAttribute('height', '0'); fsvg.style.position = 'absolute';
    fsvg.innerHTML = '<filter id="w-bend" x="0" y="-30%" width="100%" height="160%"><feTurbulence type="fractalNoise" baseFrequency="0.0045 0.035" numOctaves="1" seed="4" result="n"/><feDisplacementMap id="w-bend-map" in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G"/></filter>';
    water.appendChild(fsvg);
    const bendMap = fsvg.querySelector('#w-bend-map'), ripples = water.querySelector('.ripples');
    let bendOn = false;
    const ctx = cv.getContext('2d');
    let w = 0, h = 0, dpr = 1;
    const fit = () => { dpr = Math.min(devicePixelRatio || 1, 2); w = cv.clientWidth; h = cv.clientHeight; cv.width = w * dpr; cv.height = h * dpr; };
    fit(); addEventListener('resize', fit);
    const glints = [], wind = { vx: 0, vy: 0, x: 0, y: 0 };
    const movers = [...water.querySelectorAll('.mover')].map((host) => ({ host, el: host.querySelector('b'), x: 0, v: 0, k: host.classList.contains('boat') ? 0.45 : 1 }));
    let px = 0, py = 0, pt = 0, raf = 0, last = 0, onScreen = false;
    const tick = (t) => {
      raf = 0;
      const dt = Math.min((t - last) / 1000, 0.05); last = t;
      wind.vx *= Math.pow(0.03, dt); wind.vy *= Math.pow(0.03, dt);   /* the gust dies away by itself */
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h); ctx.fillStyle = '#efe6d3';
      for(let i = glints.length - 1; i >= 0; i--){
        const g = glints[i]; g.age += dt;
        if(g.age >= g.ttl){ glints.splice(i, 1); continue; }
        g.x += g.vx * dt; g.y += g.vy * dt;
        ctx.globalAlpha = 0.13 * Math.sin(Math.PI * g.age / g.ttl);
        ctx.beginPath(); ctx.ellipse(g.x, g.y, g.len / 2, 0.9, 0, 0, 6.2832); ctx.fill();
      }
      const bend = Math.min(1, Math.hypot(wind.vx, wind.vy) / 900);
      if(bend > 0.03){ if(!bendOn){ ripples.style.filter = 'url(#w-bend)'; bendOn = true; } bendMap.setAttribute('scale', (bend * 6).toFixed(2)); }
      else if(bendOn){ ripples.style.filter = ''; bendOn = false; }
      let busy = glints.length > 0 || Math.hypot(wind.vx, wind.vy) > 20 || bendOn;
      for(const m of movers){
        const r = m.host.getBoundingClientRect(), cr = cv.getBoundingClientRect();
        const dx = (r.left + r.width / 2 - cr.left) - wind.x, dy = (r.top + r.height / 2 - cr.top) - wind.y;
        const fall = Math.max(0, 1 - Math.hypot(dx, dy) / 280);
        const target = Math.max(-7, Math.min(7, wind.vx * 0.011 * fall)) * m.k;
        m.v += ((target - m.x) * 40 - m.v * 7) * dt; m.x += m.v * dt;   /* a soft spring: it floats off a little and drifts back */
        m.el.style.setProperty('--gx', m.x.toFixed(2) + 'px');
        if(Math.abs(m.x) > 0.04 || Math.abs(m.v) > 0.04) busy = true;
      }
      if(busy && onScreen) raf = requestAnimationFrame(tick);
    };
    const wake = () => { if(!raf && onScreen){ last = performance.now(); raf = requestAnimationFrame(tick); } };
    new IntersectionObserver((es) => { onScreen = es[0].isIntersecting; if(onScreen) wake(); }).observe(sec);
    document.addEventListener('pointermove', (e) => {
      if(e.pointerType === 'touch' || !onScreen) return;
      const r = cv.getBoundingClientRect(), now = performance.now(), dtm = Math.max(8, now - pt);
      if(e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom){
        wind.vx = Math.max(-1000, Math.min(1000, (e.clientX - px) / dtm * 1000)); wind.vy = Math.max(-600, Math.min(600, (e.clientY - py) / dtm * 1000));
        wind.x = e.clientX - r.left; wind.y = e.clientY - r.top;
        const sp = Math.hypot(wind.vx, wind.vy);
        if(sp > 220 && glints.length < 36){
          const n = sp > 700 ? 3 : 2;
          for(let i = 0; i < n; i++) glints.push({ x: wind.x + (Math.random() - 0.5) * 40, y: wind.y + (Math.random() - 0.5) * 26, vx: wind.vx * 0.1 + (Math.random() - 0.5) * 8, vy: wind.vy * 0.05, len: 12 + Math.random() * 22, age: 0, ttl: 0.9 + Math.random() * 0.7 });
        }
        wake();
      }
      px = e.clientX; py = e.clientY; pt = now;
    }, { passive: true });
  }
</script>
