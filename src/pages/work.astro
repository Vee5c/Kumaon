---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="All work · Kumaon & Co.">
  <Header />
  <main class="wrap gutter" style="min-height:60svh; padding-block:clamp(72px, 14vh, 140px);">
    <span class="idx">All work /</span>
    <h1 style="font-size:clamp(2.6rem, 8vw, 5.4rem);">The full archive<br />is on its way.</h1>
    <p style="max-width:44ch; margin-top:20px; color:var(--ink-dim); font-family:'Hanken Grotesk', system-ui, sans-serif; line-height:1.5;">
      More films and photos will live here. For now, the best of it is on the home page.
    </p>
    <p style="margin-top:28px;"><a href="/#work" style="font-family:'Bricolage Grotesque', system-ui, sans-serif; font-weight:700; text-decoration:underline; text-decoration-color:var(--accent); text-decoration-thickness:2px; text-underline-offset:6px;">← Back to selected work</a></p>
  </main>
  <Footer />
</Layout>
